---
import Base from '../layouts/Base.astro';
import Faq from '../components/Faq.astro';
import ServiceCards from '../components/ServiceCards.astro';
import { services, extraServices, site } from '../data/site.js';
export function getStaticPaths() {
  return [...services, ...extraServices].map((s) => ({ params: { slug: s.slug }, props: { s } }));
}
const { s } = Astro.props;
const url = `https://kullaomtanke.se/${s.slug}/`;
const schema = [
  { '@context': 'https://schema.org', '@type': 'Service', name: s.short, serviceType: s.short, url,
    provider: { '@id': 'https://kullaomtanke.se/#foretag' },
    areaServed: ['Höganäs kommun'],
    offers: { '@type': 'Offer', priceCurrency: 'SEK', price: String(site.hourlyBefore), description: `${site.hourlyBefore} kr per timme inklusive moms före RUT-avdrag, ${site.hourly} kr efter RUT-avdrag där tjänsten ger avdrag.` } },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: s.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Start', item: 'https://kullaomtanke.se/' },
    { '@type': 'ListItem', position: 2, name: s.short, item: url } ] },
];
---
<Base title={s.title} description={s.description} schema={schema}>
  <div class="wrap page-hero stack">
    <p class="breadcrumbs"><a href="/">Start</a> / {s.short}</p>
    <h1>{s.h1}</h1>
    <p class="lead">{s.lead}</p>
    <div class="btn-row"><a class="btn btn-primary" href="/kontakt/">Boka ett första möte</a><a class="btn btn-outline" href={`tel:${site.phoneIntl}`}>Ring {site.phone}</a></div>
  </div>
  <section class="section white">
    <div class="wrap prose">
      {s.sections.map((sec) => (
        <>
          <h2>{sec.h}</h2>
          {sec.p && sec.p.map((t) => <p>{t}</p>)}
          {sec.list && <ul>{sec.list.map((li) => <li>{li}</li>)}</ul>}
        </>
      ))}
      <h2>Pris och RUT-avdrag</h2>
      <p>{s.rut}</p>
      <p>Timpris {site.hourly} kr inklusive moms efter RUT-avdrag ({site.hourlyBefore} kr före). <a href="/priser-och-rut/">Se alla priser och paket</a>.</p>
    </div>
  </section>
  <section class="section"><div class="wrap stack"><Faq items={s.faq} /></div></section>
  <section class="section white"><div class="wrap stack"><h2>Fler sätt vi kan hjälpa till</h2><ServiceCards exclude={s.slug} /></div></section>
</Base>
